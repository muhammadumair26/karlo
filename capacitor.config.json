{
  "appId": "com.orionsoftsol.karlo",
  "appName": "Karlo",
  "webDir": "dist",
  "server": {
    "url": "https://karlo.orionsoftsol.com",
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#1d4ed8",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1d4ed8",
      "overlaysWebView": false
    }
  },
  "ios": {
    "backgroundColor": "#1d4ed8"
  }
}
